    "/v1/network": {
      "get": {
        "tags": [
          "Network"
        ],
        "summary": "Network hierarchy as a flat list of nodes",
        "description": "Zone > circle > division > subdivision > substation > feeder > transformer. Each node has a `parentId`, so the tree can be rebuilt client side. Node IDs are full code paths because codes below zone level are reused under different parents in the portal data.",
        "parameters": [
          {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/NetworkLevel"
                },
                {
                  "description": "Only nodes at this level"
                }
              ]
            },
            "required": false,
            "description": "Only nodes at this level",
            "name": "level",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Only direct children of this node",
              "example": "Z-01"
            },
            "required": false,
            "description": "Only direct children of this node",
            "name": "parentId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
