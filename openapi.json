    "/v1/meters/{meterId}/consumption": {
      "get": {
        "tags": [
          "Readings"
        ],
        "summary": "Energy used per interval or per day",
        "description": "Derived from consecutive register readings (usage = difference between readings). Intervals where the register goes down are returned as null and reported in `dataIssues`.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,32}$",
              "example": "J100001"
            },
            "required": true,
            "name": "meterId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "description": "Start date, inclusive (portal local time)",
              "example": "2026-06-01"
            },
            "required": false,
            "description": "Start date, inclusive (portal local time)",
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "End date, inclusive (portal local time)",
              "example": "2026-06-07"
            },
            "required": false,
            "description": "End date, inclusive (portal local time)",
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "interval",
                "day"
              ],
              "default": "day",
              "description": "interval = one point per reading gap (30 min or 1 day depending on meter); day = daily totals"
            },
            "required": false,
            "description": "interval = one point per reading gap (30 min or 1 day depending on meter); day = daily totals",
            "name": "granularity",
