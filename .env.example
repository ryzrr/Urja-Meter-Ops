# Portal access (required)
PORTAL_BASE_URL=https://urja-ops.flockenergy.tech
PORTAL_EMAIL=operator@urja.local
PORTAL_PASSWORD=change-me

# HTTP server
PORT=3000

# How long the meter/transformer snapshot is served before a background refresh (seconds)
SNAPSHOT_TTL_SECONDS=600

# How long a fetched readings window is reused (seconds)
READINGS_TTL_SECONDS=900

# Client-side throttle. The portal allows roughly 120 requests per 30s; stay below it.
PORTAL_MAX_REQUESTS=90
PORTAL_WINDOW_SECONDS=30
PORTAL_TIMEOUT_SECONDS=15

# Offset of the portal's local timestamps (no zone is sent by the portal; assumed IST)
PORTAL_UTC_OFFSET=+05:30
